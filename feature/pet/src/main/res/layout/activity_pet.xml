<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7F8F2"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pet_page_subtitle" android:textSize="14sp" android:textColor="#6B8073"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/pet_page_title" android:textSize="26sp" android:textStyle="bold" android:textColor="#203E32"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/pet_scene_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:padding="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pet_white_background" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:id="@+id/pet_level_text" android:text="" android:textSize="16sp" android:textStyle="bold" android:textColor="#203E32"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/pet_name_text" android:text="" android:textColor="#203E32" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/pet_speech_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/pet_white_background" android:padding="6dp" android:text="@string/pet_speech" android:textColor="#365B49" android:textSize="14sp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </LinearLayout>
    <com.example.pet.feature.pet.ui.PetAvatarView android:id="@+id/pet_avatar" android:layout_width="match_parent" android:layout_height="@dimen/pet_avatar_height" android:src="@drawable/pet_cow_default" android:scaleType="fitCenter" android:contentDescription="@string/pet_tap_description" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
<LinearLayout android:id="@+id/pet_primary_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_feed_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:minHeight="56dp" android:padding="6dp" android:background="@drawable/pet_feed_background" app:backgroundTint="@null" android:textColor="#365B49" android:textSize="15sp" android:textAllCaps="false" android:text="@string/pet_feed_action"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_dress_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="56dp" android:padding="6dp" android:background="@drawable/pet_dress_background" app:backgroundTint="@null" android:textColor="#365B49" android:textSize="15sp" android:textAllCaps="false" android:text="@string/pet_dress_action"/>
</LinearLayout>
<TextView android:id="@+id/pet_outfit_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/pet_outfit_loading" android:textColor="#365B49" android:paddingTop="8dp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_remove_outfit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/pet_dress_background" app:backgroundTint="@null" android:textColor="#365B49" android:text="@string/pet_remove_outfit" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="12dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/pet_exp_label" android:textColor="#203E32" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/pet_exp_text" android:text="" android:textColor="#5D7468" android:textSize="14sp"/>
</LinearLayout>
<ProgressBar android:id="@+id/pet_exp_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/pet_progress" android:progressTint="#3F876A" android:progressBackgroundTint="#E7EEE8" android:indeterminate="false" android:max="100" android:progress="0" android:contentDescription="@null"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/pet_growth_hint" android:textColor="#6B8073" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="12dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/pet_mood_label" android:textColor="#203E32" android:textSize="16sp" android:textStyle="normal"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/pet_mood_text" android:text="" android:textColor="#5D7468" android:textSize="14sp"/>
</LinearLayout>
<ProgressBar android:id="@+id/pet_mood_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/pet_progress" android:progressTint="#E6A064" android:progressBackgroundTint="#E7EEE8" android:indeterminate="false" android:max="100" android:progress="0" android:contentDescription="@null"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="12dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/pet_satiety_label" android:textColor="#203E32" android:textSize="16sp" android:textStyle="normal"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/pet_satiety_text" android:text="" android:textColor="#5D7468" android:textSize="14sp"/>
</LinearLayout>
<ProgressBar android:id="@+id/pet_satiety_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/pet_progress" android:progressTint="#78B4A2" android:progressBackgroundTint="#E7EEE8" android:indeterminate="false" android:max="100" android:progress="0" android:contentDescription="@null"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:id="@+id/pet_data_status" android:text="@string/pet_loading" android:textColor="#6B8073" android:textSize="12sp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_shop_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:background="@drawable/pet_dress_background" app:backgroundTint="@null" android:textColor="#365B49" android:text="@string/pet_shop_action"/>
<Button android:id="@+id/cd_debug_exp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="联调：真实经验 +100（会保存）" android:visibility="gone"/>
</LinearLayout></ScrollView>
