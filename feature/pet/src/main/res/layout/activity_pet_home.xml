<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pet_home_wall">
<com.example.pet.feature.pet.ui.PetLandscapeView android:id="@+id/pet_landscape" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pet_background" android:importantForAccessibility="no"/>
<View android:layout_width="match_parent" android:layout_height="260dp" android:layout_gravity="top" android:background="@drawable/pet_scene_top_fade" android:importantForAccessibility="no"/>
<View android:layout_width="match_parent" android:layout_height="220dp" android:layout_gravity="bottom" android:background="@drawable/pet_scene_bottom_fade" android:importantForAccessibility="no"/>
<ScrollView android:id="@+id/pet_home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="16dp" android:paddingTop="4dp">
<ImageButton android:id="@+id/pet_back_button" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/pet_ic_back" android:contentDescription="@string/pet_back" android:background="?attr/selectableItemBackgroundBorderless"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="8dp"><TextView android:id="@+id/pet_name_text" style="@style/PetHomeLabel" android:text="@string/pet_page_title" android:textSize="24sp" android:textStyle="bold"/><TextView style="@style/PetHomeLabel" android:text="@string/pet_home_subtitle" android:textSize="12sp"/></LinearLayout>
<TextView android:id="@+id/pet_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:padding="10dp" android:textSize="14sp" android:textColor="@color/pet_home_ink" android:background="@drawable/pet_home_glass"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="4dp">
<LinearLayout style="@style/PetHomeMetric"><TextView android:id="@+id/pet_level_text" style="@style/PetHomeLabel"/><ProgressBar android:id="@+id/pet_exp_progress" style="@style/PetHomeProgress" android:progressTint="#658F64"/><TextView android:id="@+id/pet_exp_text" style="@style/PetHomeLabel" android:textSize="12sp"/></LinearLayout>
<LinearLayout style="@style/PetHomeMetric"><TextView style="@style/PetHomeLabel" android:text="@string/pet_mood_label"/><ProgressBar android:id="@+id/pet_mood_progress" style="@style/PetHomeProgress" android:progressTint="#D99E67"/><TextView android:id="@+id/pet_mood_text" style="@style/PetHomeLabel" android:textSize="12sp"/></LinearLayout>
<LinearLayout style="@style/PetHomeMetric"><TextView style="@style/PetHomeLabel" android:text="@string/pet_satiety_label"/><ProgressBar android:id="@+id/pet_satiety_progress" style="@style/PetHomeProgress" android:progressTint="#72A99B"/><TextView android:id="@+id/pet_satiety_text" style="@style/PetHomeLabel" android:textSize="12sp"/></LinearLayout>
</LinearLayout>
<TextView android:id="@+id/pet_speech_text" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:padding="10dp" android:background="@drawable/pet_home_glass" android:text="@string/pet_speech" android:textSize="14sp" android:textColor="@color/pet_home_ink" android:accessibilityLiveRegion="polite"/>
<FrameLayout android:id="@+id/pet_stage" android:layout_width="match_parent" android:layout_height="@dimen/pet_home_stage_min" android:layout_weight="1">
<com.example.pet.feature.pet.ui.PetAvatarView android:id="@+id/pet_avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="8dp" android:paddingBottom="20dp" android:src="@drawable/pet_cow_default" android:contentDescription="@string/pet_tap_description" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
</FrameLayout>
<LinearLayout android:id="@+id/pet_home_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="8dp"><androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_feed_button" style="@style/PetHomeAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:drawableStart="@drawable/pet_ic_food" android:background="@drawable/pet_home_food_button" android:text="@string/pet_feed_action"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_dress_button" style="@style/PetHomeAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:drawableStart="@drawable/pet_ic_dress" android:text="@string/pet_dress_action"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp"><androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_shop_button" style="@style/PetHomeNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/pet_ic_shop" android:text="@string/pet_nav_shop"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_tasks_button" style="@style/PetHomeNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:drawableTop="@drawable/pet_ic_tasks" android:text="@string/pet_nav_tasks"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/pet_chat_button" style="@style/PetHomeNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:drawableTop="@drawable/pet_ic_chat" android:text="@string/pet_nav_chat"/></LinearLayout>
<TextView android:id="@+id/pet_data_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center" android:padding="4dp" android:textSize="12sp" android:textColor="@color/pet_home_muted"/>
<Button android:id="@+id/cd_debug_exp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="联调：真实经验 +100（会保存）" android:visibility="gone"/>
</LinearLayout>
</LinearLayout></ScrollView>
<FrameLayout android:id="@+id/pet_care_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:visibility="gone"/>
</FrameLayout>
