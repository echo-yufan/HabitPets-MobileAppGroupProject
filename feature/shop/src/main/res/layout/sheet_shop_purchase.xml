<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:background="@drawable/shop_bg_sheet">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/shop_sheet_padding">
 <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:background="@drawable/shop_bg_image"/>
 <ImageView android:id="@+id/productImage" android:layout_width="match_parent" android:layout_height="104dp" android:importantForAccessibility="no"/>
 <TextView android:id="@+id/purchaseTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/shop_text" android:layout_marginTop="12dp"/>
 <TextView android:id="@+id/purchaseDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/shop_secondary" android:layout_marginTop="6dp"/>
 <TextView android:id="@+id/purchaseCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:padding="6dp" android:background="@drawable/shop_bg_tag" android:textColor="@color/shop_text"/>
 <TextView android:id="@+id/purchaseLevel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/shop_gold" android:layout_marginTop="10dp"/>
 <TextView android:id="@+id/unitPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/shop_secondary" android:layout_marginTop="16dp"/>
 <LinearLayout android:id="@+id/quantityRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="10dp">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/shop_quantity_title" android:textColor="@color/shop_text"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/quantityMinus" style="@style/ShopButton" android:layout_width="48dp" android:layout_height="@dimen/shop_touch_target" android:padding="0dp" android:minWidth="0dp" android:contentDescription="@string/shop_minus" android:text="@string/shop_minus_symbol"/>
  <TextView android:id="@+id/purchaseQuantity" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:textColor="@color/shop_text" android:accessibilityLiveRegion="polite"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/quantityPlus" style="@style/ShopButton" android:layout_width="48dp" android:layout_height="@dimen/shop_touch_target" android:padding="0dp" android:minWidth="0dp" android:contentDescription="@string/shop_plus" android:text="@string/shop_plus_symbol"/>
 </LinearLayout>
 <TextView android:id="@+id/purchasePrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/shop_gold" android:textStyle="bold" android:layout_marginTop="24dp"/>
 <TextView android:id="@+id/purchaseBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/shop_secondary" android:layout_marginTop="16dp"/>
 <TextView android:id="@+id/purchaseAfter" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/shop_text" android:layout_marginTop="8dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/purchaseHint" android:text="@string/shop_quantity_hint" android:textColor="@color/shop_secondary" android:textSize="12sp" android:layout_marginTop="16dp"/>
 <TextView android:id="@+id/purchaseError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/shop_error" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/confirmPurchase" style="@style/ShopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/shop_confirm"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/cancelPurchase" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_cancel"/>
</LinearLayout></ScrollView>
