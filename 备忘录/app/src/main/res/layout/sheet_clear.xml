<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="13dp"
    android:paddingEnd="22dp"
    android:paddingBottom="30dp">

    <View
        android:layout_width="39dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clear_sheet_title"
        android:textColor="@color/sheet_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/clear_sheet_desc"
        android:textColor="@color/sheet_desc"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/btn_clear_done"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clear_done_option"
            android:textColor="@color/option_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron_right"
            android:textColor="@color/option_text"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_clear_all"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_option_danger"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clear_all_option"
            android:textColor="@color/danger_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron_right"
            android:textColor="@color/danger_text"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
